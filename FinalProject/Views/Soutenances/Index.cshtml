@model IEnumerable<FinalProject.Models.Soutenance>

@{
    ViewData["Title"] = "Index";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/5.3.0/css/bootstrap.min.css">
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" />
<script defer src="https://code.jquery.com/jquery-3.7.0.js"></script>
<script defer src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
<script defer src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
<script defer src="~/js/site.js"></script>
<p></p>
<h3>Index</h3>

<p>
    <a class="badge badge-sm bg-gradient-primary" asp-action="Create">Create New</a>
</p>
<div class="card-body px-0 pt-0 pb-2">
    <div class="table-responsive p-0">
        <table id="myTable" class="table table-striped align-items-center mb-0">
    <thead>
        <tr>
                    <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">
                        <div class="d-flex px-2">
                            @Html.DisplayNameFor(model => model.Date)
                            </div>
            </th>
                    <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">
                        <div class="d-flex px-2">
                            @Html.DisplayNameFor(model => model.Heure)
                        </div>
            </th>
                    <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">
                        <div class="d-flex px-2">
                            @Html.DisplayNameFor(model => model.PFE)
                        </div>
            </th>
                    <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">
                        <div class="d-flex px-2">
                            @Html.DisplayNameFor(model => model.President)
                        </div>
            </th>
                    <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">
                        <div class="d-flex px-2">
                            @Html.DisplayNameFor(model => model.Rapporteur)
                        </div>
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="align-items-center">
                            <div class="d-flex px-2">
                                <p class="text-xs text-secondary mb-0">
                                    @Html.DisplayFor(modelItem => item.Date)
                                </p>
                            </div>
                        </td>
                        <td class="align-items-center">
                            <div class="d-flex px-2">
                                <p class="text-xs text-secondary mb-0">
                                    @Html.DisplayFor(modelItem => item.Heure)
                                </p>
                            </div>
                        </td>
                        <td class="align-items-center">
                            <div class="d-flex px-2">
                                <p class="text-xs text-secondary mb-0">
                                    @if (item.PFE != null)
                                    {
                                        @Html.DisplayFor(modelItem => item.PFE.Titre)
                                    }
                                </p>
                            </div>
                        </td>
                        <td class="align-items-center">
                            <div class="d-flex px-2">
                                <p class="text-xs text-secondary mb-0">
                                    @if (item.President != null)
                                    {
                                        @Html.DisplayFor(modelItem => item.President.NomPrenom)
                                    }
                                </p>
                            </div>
                        </td>
                        <td class="align-items-center">
                            <div class="d-flex px-2">
                                <p class="text-xs text-secondary mb-0">
                                    @if (item.Rapporteur != null)
                                    {
                                        @Html.DisplayFor(modelItem => item.Rapporteur.NomPrenom)
                                    }
                                </p>
                            </div>
                        </td>
                        <td>
                            <a class="badge badge-sm bg-gradient-success" asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                            <a class="badge badge-sm bg-gradient-secondary" asp-action="Details" asp-route-id="@item.Id">Details</a> |
                            <a class="badge badge-sm bg-gradient-danger" asp-action="Delete" asp-route-id="@item.Id">Delete</a>

                        </td>
        </tr>
}
    </tbody>
</table>
    </div>
</div>